# Copy this file to .env and fill sensitive values. Do NOT commit .env to git.

# Postgres credentials (used by both the Postgres container and the Mage container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<YOUR_STRONG_PASSWORD>
POSTGRES_DB=indian_sm_dw
POSTGRES_DBNAME=indian_sm_dw
POSTGRES_HOST=mage-postgres
POSTGRES_PORT=5432

# User ID and Group ID for Docker containers (run: id -u and id -g to get your values)
UID=1000
GID=1000

# Mage DB URL (optional — MAGE_DATABASE_CONNECTION_URL overrides individual POSTGRES_ vars)
# Example: postgresql://<user>:<password>@<host>:<port>/<db>
MAGE_DATABASE_CONNECTION_URL=postgresql://postgres:<YOUR_STRONG_PASSWORD>@mage-postgres:5432/indian_sm_dw

# Optional: Mage log directory
MAGE_LOG_DIR=/app/logs
